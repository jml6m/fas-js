{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "scripts/*.{mjs,js}",
    "test/**/*.spec.js"
  ],
  "project": ["src/**/*.ts", "scripts/**/*.{mjs,js}"],
  "rules": {
    "files": "error",
    "dependencies": "warn",
    "devDependencies": "warn",
    "exports": "warn",
    "types": "warn",
    "enumMembers": "warn",
    "classMembers": "warn",
    "duplicates": "warn"
  }
}
