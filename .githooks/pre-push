#!/usr/bin/env sh
# Local pre-push gate (committed; installed via `core.hooksPath .githooks`).
# Helps human/admin pushes from a dev machine — agents branch correctly and let PR
# workflows gate, but a local commit can slip. See AGENTS.md §4.
#
# 1. Reserved-name guard: block pushing a reserved version-integration branch name
#    (v*.*-*, v*-*, chore/v*.*-*, chore/v*-*) unless it is the designated integration
#    branch in .github/INTEGRATION_BRANCH. Reads git's ref payload from stdin.
# 2. Fast static gate: typecheck -> lint -> docs:lint before anything leaves the machine.
#
# Bypass an exceptional push with `git push --no-verify`.

set -e

# (1) consumes the pre-push stdin payload
node scripts/check-branch-name.mjs

# (2) fast gate — skip the slow build/test suite; that runs in CI
echo "pre-push: running fast static gate (typecheck -> lint -> docs:lint)…"
npm run --silent typecheck
npm run --silent lint
npm run --silent docs:lint

echo "pre-push: checks passed."
